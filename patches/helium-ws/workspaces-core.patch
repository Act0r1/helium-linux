+++ b/chrome/browser/ui/workspaces/workspace_controller.cc
@@ -0,0 +1,396 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/workspaces/workspace_controller.h"
+
+#include <algorithm>
+#include <map>
+
+#include "base/auto_reset.h"
+#include "base/functional/bind.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/task/sequenced_task_runner.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/sessions/session_restore.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/browser/ui/unload_controller.h"
+#include "chrome/grit/generated_resources.h"
+#include "components/tabs/public/tab_group.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace workspaces {
+
+DEFINE_USER_DATA(WorkspaceController);
+
+WorkspaceController::WorkspaceController(BrowserWindowInterface* browser)
+    : browser_(browser),
+      model_(browser->GetTabStripModel()),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {
+  CHECK_EQ(browser->GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser->GetProfile()->IsRegularProfile());
+  CHECK(model_->SupportsTabGroups());
+  model_->AddObserver(this);
+  if (auto* state = tabs::VerticalTabStripStateController::From(browser)) {
+    mode_subscription_ = state->RegisterOnModeChanged(base::BindRepeating(
+        [](WorkspaceController* controller,
+           tabs::VerticalTabStripStateController*) {
+          controller->ScheduleUpdate();
+        },
+        base::Unretained(this)));
+  }
+  restore_subscription_ =
+      SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+          &WorkspaceController::OnSessionRestored, base::Unretained(this)));
+  ScheduleUpdate();
+}
+
+WorkspaceController::~WorkspaceController() {
+  TabStripModelObserver::StopObservingAll(this);
+}
+
+WorkspaceController* WorkspaceController::From(
+    BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+std::vector<tab_groups::TabGroupId> WorkspaceController::GetWorkspaces() const {
+  std::vector<tab_groups::TabGroupId> groups;
+  if (model_) {
+    for (auto* tab : *model_) {
+      if (auto group = tab->GetGroup();
+          group && !std::ranges::contains(groups, *group)) {
+        groups.push_back(*group);
+      }
+    }
+  }
+  return groups;
+}
+
+std::optional<tab_groups::TabGroupId> WorkspaceController::GetActiveWorkspace()
+    const {
+  if (!model_) {
+    return std::nullopt;
+  }
+  if (auto* tab = model_->GetActiveTab(); tab && tab->GetGroup()) {
+    return tab->GetGroup();
+  }
+  if (last_active_group_ &&
+      model_->group_model()->ContainsTabGroup(*last_active_group_)) {
+    return last_active_group_;
+  }
+  return model_->group_model()->GetMostRecentTabGroupId();
+}
+
+void WorkspaceController::ActivateWorkspace(const tab_groups::TabGroupId& id) {
+  if (!model_) {
+    return;
+  }
+  tabs::TabInterface* most_recent = nullptr;
+  for (auto it = activation_order_.rbegin(); it != activation_order_.rend();
+       ++it) {
+    if (auto* tab = it->Get();
+        tab && tab->GetGroup() == id &&
+        model_->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+      most_recent = tab;
+      break;
+    }
+  }
+  if (!most_recent) {
+    for (auto* tab : *model_) {
+      if (tab->GetGroup() == id &&
+          (!most_recent ||
+           tab->GetLastActiveTime() > most_recent->GetLastActiveTime())) {
+        most_recent = tab;
+      }
+    }
+  }
+  if (most_recent) {
+    model_->ActivateTab(most_recent);
+    UpdateCollapsedGroups();
+    ScheduleUpdate();
+  }
+}
+
+void WorkspaceController::ActivateWorkspaceAt(int index) {
+  const auto groups = GetWorkspaces();
+  if (index >= 0 && static_cast<size_t>(index) < groups.size()) {
+    ActivateWorkspace(groups[index]);
+  }
+}
+
+void WorkspaceController::ActivateRelativeWorkspace(int offset) {
+  const auto groups = GetWorkspaces();
+  if (groups.empty()) {
+    return;
+  }
+  const auto active = GetActiveWorkspace();
+  const auto it = active ? std::ranges::find(groups, *active) : groups.end();
+  const int count = static_cast<int>(groups.size());
+  const int index =
+      it == groups.end() ? 0 : static_cast<int>(it - groups.begin());
+  ActivateWorkspace(groups[(index + offset + count) % count]);
+}
+
+void WorkspaceController::ActivateNextWorkspace() {
+  ActivateRelativeWorkspace(1);
+}
+
+void WorkspaceController::ActivatePreviousWorkspace() {
+  ActivateRelativeWorkspace(-1);
+}
+
+tab_groups::TabGroupId WorkspaceController::CreateNamedWorkspace(
+    const std::u16string& title) {
+  base::AutoReset<bool> updating(&updating_, true);
+  model_->delegate()->AddTabAt(GURL(), -1, true);
+  model_->ForgetOpener(model_->GetActiveWebContents());
+  const auto id = model_->AddToNewGroup({model_->active_index()});
+  const auto color =
+      model_->group_model()->GetTabGroup(id)->visual_data()->color();
+  model_->ChangeTabGroupVisuals(id,
+                                tab_groups::TabGroupVisualData(title, color));
+  return id;
+}
+
+tab_groups::TabGroupId WorkspaceController::CreateWorkspace() {
+  const auto id = CreateNamedWorkspace(l10n_util::GetStringFUTF16(
+      IDS_WORKSPACE_NEW_NAME,
+      base::NumberToString16(GetWorkspaces().size() + 1)));
+  UpdateCollapsedGroups();
+  ScheduleUpdate();
+  return id;
+}
+
+void WorkspaceController::CloseWorkspace(const tab_groups::TabGroupId& id) {
+  if (!model_->group_model()->ContainsTabGroup(id) || IsClosingWindow()) {
+    return;
+  }
+  if (GetWorkspaces().size() == 1) {
+    CreateNamedWorkspace(l10n_util::GetStringUTF16(IDS_WORKSPACE_DEFAULT_NAME));
+  } else if (GetActiveWorkspace() == id) {
+    ActivateNextWorkspace();
+  }
+  closing_workspaces_.insert(id);
+  model_->CloseAllTabsInGroup(id);
+  ScheduleUpdate();
+}
+
+bool WorkspaceController::IsTabVisible(const tabs::TabInterface* tab) const {
+  return tab && (tab->IsPinned() ||
+                 (tab->GetGroup() && tab->GetGroup() == GetActiveWorkspace()));
+}
+
+std::vector<tabs::TabInterface*> WorkspaceController::GetVisibleTabs() const {
+  std::vector<tabs::TabInterface*> tabs;
+  if (model_) {
+    for (auto* tab : *model_) {
+      if (IsTabVisible(tab)) {
+        tabs.push_back(tab);
+      }
+    }
+  }
+  return tabs;
+}
+
+void WorkspaceController::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void WorkspaceController::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+bool WorkspaceController::IsClosingWindow() const {
+  if (!model_ || model_->closing_all()) {
+    return true;
+  }
+  const auto* unload = UnloadController::From(browser_);
+  return unload && (unload->is_attempting_to_close_browser() ||
+                    unload->is_delete_scheduled());
+}
+
+void WorkspaceController::PrepareForTabRemoval(
+    const std::vector<tabs::TabInterface*>& tabs,
+    std::optional<tab_groups::TabGroupId> destination) {
+  if (updating_ || IsClosingWindow() ||
+      SessionRestore::IsRestoring(browser_->GetProfile())) {
+    return;
+  }
+  std::map<tab_groups::TabGroupId, size_t> leaving;
+  for (auto* tab : tabs) {
+    if (auto group = tab->GetGroup(); group && group != destination) {
+      ++leaving[*group];
+    }
+  }
+  base::AutoReset<bool> updating(&updating_, true);
+  for (const auto& [id, count] : leaving) {
+    auto* group = model_->group_model()->GetTabGroup(id);
+    if (closing_workspaces_.contains(id)) {
+      continue;
+    }
+    if (count == static_cast<size_t>(group->tab_count())) {
+      group->SetGroupIsClosing(false);
+      model_->delegate()->AddTabAt(GURL(), -1, false, id);
+    }
+  }
+}
+
+void WorkspaceController::ScheduleUpdate() {
+  if (updating_ || update_pending_ || !model_) {
+    return;
+  }
+  update_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WorkspaceController::Update, weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceController::Update() {
+  update_pending_ = false;
+  if (IsClosingWindow() ||
+      SessionRestore::IsRestoring(browser_->GetProfile())) {
+    return;
+  }
+  {
+    base::AutoReset<bool> updating(&updating_, true);
+    auto group = GetActiveWorkspace();
+    std::vector<tabs::TabInterface*> ungrouped;
+    for (auto* tab : *model_) {
+      if (!tab->IsPinned() && !tab->GetGroup()) {
+        ungrouped.push_back(tab);
+      }
+    }
+    for (auto* tab : ungrouped) {
+      const int index = model_->GetIndexOfTab(tab);
+      if (group) {
+        model_->AddToExistingGroup({index}, *group);
+      } else {
+        group = model_->AddToNewGroup({index});
+        const auto color =
+            model_->group_model()->GetTabGroup(*group)->visual_data()->color();
+        model_->ChangeTabGroupVisuals(
+            *group,
+            tab_groups::TabGroupVisualData(
+                l10n_util::GetStringUTF16(IDS_WORKSPACE_DEFAULT_NAME), color));
+      }
+    }
+    std::erase_if(closing_workspaces_, [this](const auto& id) {
+      return !model_->group_model()->ContainsTabGroup(id) ||
+             !model_->group_model()->GetTabGroup(id)->IsGroupClosing();
+    });
+    if (auto* tab = model_->GetActiveTab(); tab && tab->GetGroup()) {
+      last_active_group_ = tab->GetGroup();
+    }
+    UpdateCollapsedGroups();
+  }
+  const auto active = GetActiveWorkspace();
+  if (active != last_notified_workspace_) {
+    last_notified_workspace_ = active;
+    for (auto& observer : observers_) {
+      observer.OnActiveWorkspaceChanged();
+    }
+  }
+  for (auto& observer : observers_) {
+    observer.OnWorkspacesChanged();
+  }
+}
+
+void WorkspaceController::UpdateCollapsedGroups() {
+  if (!model_) {
+    return;
+  }
+  base::AutoReset<bool> updating(&updating_, true);
+  const auto active = GetActiveWorkspace();
+  auto* state = tabs::VerticalTabStripStateController::From(browser_);
+  const bool vertical = state && state->ShouldDisplayVerticalTabs();
+  for (const auto& id : GetWorkspaces()) {
+    auto* group = model_->group_model()->GetTabGroup(id);
+    const auto* visuals = group->visual_data();
+    const bool collapsed = !vertical && id != active;
+    if (visuals->is_collapsed() != collapsed) {
+      model_->ChangeTabGroupVisuals(
+          id, tab_groups::TabGroupVisualData(visuals->title(), visuals->color(),
+                                             collapsed));
+    }
+  }
+}
+
+void WorkspaceController::OnSessionRestored(Profile* profile, int tab_count) {
+  if (profile == browser_->GetProfile()) {
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WorkspaceController::ScheduleUpdate,
+                                  weak_factory_.GetWeakPtr()));
+  }
+}
+
+void WorkspaceController::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kRemoved) {
+    for (const auto& removed : change.GetRemove()->contents) {
+      std::erase(activation_order_, removed.tab->GetHandle());
+    }
+  }
+  if (selection.new_tab) {
+    if (selection.new_tab->GetGroup()) {
+      last_active_group_ = selection.new_tab->GetGroup();
+    }
+    if (selection.active_tab_changed()) {
+      const auto handle = selection.new_tab->GetHandle();
+      std::erase(activation_order_, handle);
+      activation_order_.push_back(handle);
+    }
+  }
+  ScheduleUpdate();
+}
+
+void WorkspaceController::TabGroupedStateChanged(
+    TabStripModel* model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  if (tab == model_->GetActiveTab() && new_group) {
+    last_active_group_ = new_group;
+  }
+  if (old_group && new_group && old_group != new_group &&
+      model_->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+    model_->ForgetOpener(tab->GetContents());
+  }
+  ScheduleUpdate();
+}
+
+void WorkspaceController::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                  int index) {
+  ScheduleUpdate();
+}
+
+void WorkspaceController::OnTabGroupChanged(const TabGroupChange& change) {
+  if (!updating_ && change.type == TabGroupChange::kVisualsChanged &&
+      !SessionRestore::IsRestoring(browser_->GetProfile())) {
+    const auto* visuals = change.GetVisualsChange();
+    if (visuals->old_visuals->is_collapsed() &&
+        !visuals->new_visuals->is_collapsed() &&
+        change.group != GetActiveWorkspace()) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+          FROM_HERE, base::BindOnce(&WorkspaceController::ActivateWorkspace,
+                                    weak_factory_.GetWeakPtr(), change.group));
+      return;
+    }
+  }
+  ScheduleUpdate();
+}
+
+void WorkspaceController::OnTabStripModelDestroyed(TabStripModel* model) {
+  model_ = nullptr;
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+}  // namespace workspaces
