+TEST_F(WorkspaceControllerTest, ExplicitCloseReplacesOnlyWorkspace) {
+  const auto group = AddUngroupedTab()->GetGroup().value();
+  controller()->CloseWorkspace(group);
+  Flush();
+  EXPECT_FALSE(model()->group_model()->ContainsTabGroup(group));
+  EXPECT_EQ(1u, controller()->GetWorkspaces().size());
+  EXPECT_EQ(1, model()->count());
+}
