+DEFINE_USER_DATA(WorkspaceController);
+
+WorkspaceController::WorkspaceController(BrowserWindowInterface* browser)
+    : browser_(browser),
+      model_(browser->GetTabStripModel()),
+      scoped_unowned_user_data_(browser->GetUnownedUserDataHost(), *this) {
+  CHECK_EQ(browser->GetType(), BrowserWindowInterface::TYPE_NORMAL);
+  CHECK(browser->GetProfile()->IsRegularProfile());
+  if (const auto* init = BrowserInitState::From(browser)) {
+    Deserialize(init->create_params().workspaces, &workspaces_, &active_);
+  }
+  if (workspaces_.empty()) {
+    workspaces_.push_back(
+        {NewId(), l10n_util::GetStringUTF16(IDS_WORKSPACE_DEFAULT_NAME),
+         FreeIcon(workspaces_), ColorForIndex(0)});
+  }
+  FillMissingIcons(workspaces_);
+  if (!FindWorkspace(active_)) {
+    active_ = workspaces_.front().id;
+  }
+  model_->AddObserver(this);
+  if (auto* state = tabs::VerticalTabStripStateController::From(browser)) {
+    mode_subscription_ = state->RegisterOnModeChanged(base::BindRepeating(
+        [](WorkspaceController* controller,
+           tabs::VerticalTabStripStateController*) {
+          controller->ScheduleUpdate();
+        },
+        base::Unretained(this)));
+  }
+  restore_subscription_ =
+      SessionRestore::RegisterOnSessionRestoredCallback(base::BindRepeating(
+          &WorkspaceController::OnSessionRestored, base::Unretained(this)));
+  ScheduleUpdate();
+}
+
+WorkspaceController::~WorkspaceController() {
+  TabStripModelObserver::StopObservingAll(this);
+}
+
+// static
+WorkspaceController* WorkspaceController::From(
+    BrowserWindowInterface* browser) {
+  return browser ? Get(browser->GetUnownedUserDataHost()) : nullptr;
+}
+
+// static
+std::string WorkspaceController::Serialize(
+    const std::vector<Workspace>& workspaces,
+    const std::string& active) {
+  base::ListValue list;
+  for (const auto& workspace : workspaces) {
+    list.Append(base::DictValue()
+                    .Set(kIdKey, workspace.id)
+                    .Set(kNameKey, base::UTF16ToUTF8(workspace.name))
+                    .Set(kIconKey, base::UTF16ToUTF8(workspace.icon))
+                    .Set(kColorKey, static_cast<int>(workspace.color)));
+  }
+  return base::WriteJson(base::DictValue()
+                             .Set(kActiveKey, active)
+                             .Set(kWorkspacesKey, std::move(list)))
+      .value_or(std::string());
+}
+
+// static
+bool WorkspaceController::Deserialize(const std::string& json,
+                                      std::vector<Workspace>* workspaces,
+                                      std::string* active) {
+  std::optional<base::DictValue> root =
+      base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC);
+  if (!root) {
+    return false;
+  }
+  const base::ListValue* list = root->FindList(kWorkspacesKey);
+  if (!list) {
+    return false;
+  }
+  std::vector<Workspace> result;
+  for (const base::Value& value : *list) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      return false;
+    }
+    const std::string* id = dict->FindString(kIdKey);
+    const std::string* name = dict->FindString(kNameKey);
+    const std::string* icon = dict->FindString(kIconKey);
+    const std::optional<int> color = dict->FindInt(kColorKey);
+    if (!id || id->empty() || !name || !icon || !color ||
+        !tab_groups::GetTabGroupColorLabelMap().contains(
+            static_cast<tab_groups::TabGroupColorId>(*color))) {
+      return false;
+    }
+    result.push_back({*id, base::UTF8ToUTF16(*name), base::UTF8ToUTF16(*icon),
+                      static_cast<tab_groups::TabGroupColorId>(*color)});
+  }
+  const std::string* active_id = root->FindString(kActiveKey);
+  *workspaces = std::move(result);
+  *active = active_id ? *active_id : std::string();
+  return true;
+}
+
+const Workspace* WorkspaceController::GetActiveWorkspace() const {
+  return FindWorkspace(active_);
+}
+
+const Workspace* WorkspaceController::GetWorkspaceOf(
+    const tabs::TabInterface* tab) const {
+  return tab ? FindWorkspace(GetWorkspaceIdOf(tab)) : nullptr;
+}
+
+bool WorkspaceController::IsEssential(const tabs::TabInterface* tab) const {
+  return tab && GetWorkspaceIdOf(tab) == kEssentialsId;
+}
+
+void WorkspaceController::ActivateWorkspace(const std::string& id) {
+  if (!model_ || !FindWorkspace(id)) {
+    return;
+  }
+  SetActive(id);
+  tabs::TabInterface* target = nullptr;
+  for (auto it = activation_order_.rbegin(); it != activation_order_.rend();
+       ++it) {
+    if (auto* tab = it->Get();
+        tab && GetWorkspaceIdOf(tab) == id &&
+        model_->GetIndexOfTab(tab) != TabStripModel::kNoTab) {
+      target = tab;
+      break;
+    }
+  }
+  if (!target) {
+    for (auto* tab : *model_) {
+      if (GetWorkspaceIdOf(tab) == id &&
+          (!target ||
+           tab->GetLastActiveTime() > target->GetLastActiveTime())) {
+        target = tab;
+      }
+    }
+  }
+  if (target) {
+    model_->ActivateTab(target);
+  } else {
+    model_->delegate()->AddTabAt(GURL(), -1, true);
+  }
+  ScheduleUpdate();
+}
+
+void WorkspaceController::ActivateWorkspaceAt(int index) {
+  if (index >= 0 && static_cast<size_t>(index) < workspaces_.size()) {
+    ActivateWorkspace(workspaces_[index].id);
+  }
+}
+
+void WorkspaceController::ActivateRelativeWorkspace(int offset) {
+  const auto it = std::ranges::find(workspaces_, active_, &Workspace::id);
+  const int count = static_cast<int>(workspaces_.size());
+  const int index =
+      it == workspaces_.end() ? 0 : static_cast<int>(it - workspaces_.begin());
+  ActivateWorkspaceAt((index + offset + count) % count);
+}
+
+void WorkspaceController::ActivateNextWorkspace() {
+  ActivateRelativeWorkspace(1);
+}
+
+void WorkspaceController::ActivatePreviousWorkspace() {
+  ActivateRelativeWorkspace(-1);
+}
+
+std::string WorkspaceController::CreateWorkspace() {
+  const std::string id = NewId();
+  workspaces_.push_back({id, FreeName(workspaces_), FreeIcon(workspaces_),
+                         ColorForIndex(workspaces_.size())});
+  ActivateWorkspace(id);
+  NotifyWorkspacesChanged();
+  return id;
+}
+
+void WorkspaceController::UpdateWorkspace(const Workspace& workspace) {
+  auto it = std::ranges::find(workspaces_, workspace.id, &Workspace::id);
+  if (it == workspaces_.end() || *it == workspace) {
+    return;
+  }
+  *it = workspace;
+  NotifyWorkspacesChanged();
+  ScheduleUpdate();
+}
+
+void WorkspaceController::MergeRestoredWorkspaces(const std::string& json) {
+  std::vector<Workspace> restored;
+  std::string restored_active;
+  if (!Deserialize(json, &restored, &restored_active)) {
+    return;
+  }
+  bool changed = false;
+  for (Workspace& workspace : restored) {
+    if (!FindWorkspace(workspace.id)) {
+      workspaces_.push_back(std::move(workspace));
+      changed = true;
+    }
+  }
+  if (changed) {
+    FillMissingIcons(workspaces_);
+    NotifyWorkspacesChanged();
+    ScheduleUpdate();
+  }
+}
+
+void WorkspaceController::CloseWorkspace(const std::string& id) {
+  if (!model_ || workspaces_.size() <= 1 || !FindWorkspace(id) ||
+      IsClosingWindow()) {
+    return;
+  }
+  if (active_ == id) {
+    ActivateNextWorkspace();
+  }
+  std::vector<tabs::TabHandle> tabs;
+  for (auto* tab : *model_) {
+    if (GetWorkspaceIdOf(tab) == id) {
+      tabs.push_back(tab->GetHandle());
+    }
+  }
+  std::erase_if(workspaces_,
+                [&id](const Workspace& workspace) { return workspace.id == id; });
+  for (const auto& handle : tabs) {
+    if (auto* tab = handle.Get()) {
+      if (const int index = model_->GetIndexOfTab(tab);
+          index != TabStripModel::kNoTab) {
+        model_->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE |
+                                              TabCloseTypes::
+                                                  CLOSE_CREATE_HISTORICAL_TAB);
+      }
+    }
+  }
+  NotifyWorkspacesChanged();
+  ScheduleUpdate();
+}
+
+void WorkspaceController::MoveTabsToWorkspace(
+    const std::vector<tabs::TabInterface*>& tabs,
+    const std::string& id) {
+  if (!model_ || !FindWorkspace(id)) {
+    return;
+  }
+  bool moves_active = false;
+  for (auto* tab : *model_) {
+    const bool in_unit = std::ranges::any_of(tabs, [tab](auto* moved) {
+      return moved == tab ||
+             (tab->GetGroup() && tab->GetGroup() == moved->GetGroup()) ||
+             (tab->GetSplit() && tab->GetSplit() == moved->GetSplit());
+    });
+    if (in_unit) {
+      tab_workspaces_[tab->GetHandle()] = id;
+      moves_active |= tab == model_->GetActiveTab();
+    }
+  }
+  if (moves_active) {
+    SetActive(id);
+  }
+  NotifyWorkspacesChanged();
+  ScheduleUpdate();
+}
+
+void WorkspaceController::SetEssential(
+    const std::vector<tabs::TabInterface*>& tabs,
+    bool essential) {
+  for (auto* tab : tabs) {
+    tab_workspaces_[tab->GetHandle()] = essential ? kEssentialsId : active_;
+  }
+  ScheduleUpdate();
+}
+
+bool WorkspaceController::IsFilteringTabs() const {
+  const auto* state = tabs::VerticalTabStripStateController::From(browser_);
+  return state && state->ShouldDisplayVerticalTabs();
+}
+
+bool WorkspaceController::IsTabVisible(const tabs::TabInterface* tab) const {
+  if (!tab) {
+    return false;
+  }
+  if (!IsFilteringTabs()) {
+    return true;
+  }
+  const std::string id = GetWorkspaceIdOf(tab);
+  return id == active_ || id == kEssentialsId;
+}
+
+std::vector<tabs::TabInterface*> WorkspaceController::GetVisibleTabs() const {
+  std::vector<tabs::TabInterface*> tabs;
+  if (model_) {
+    for (auto* tab : *model_) {
+      if (IsTabVisible(tab)) {
+        tabs.push_back(tab);
+      }
+    }
+  }
+  return tabs;
+}
+
+void WorkspaceController::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void WorkspaceController::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+const Workspace* WorkspaceController::FindWorkspace(
+    const std::string& id) const {
+  const auto it = std::ranges::find(workspaces_, id, &Workspace::id);
+  return it == workspaces_.end() ? nullptr : &*it;
+}
+
+std::string WorkspaceController::GetWorkspaceIdOf(
+    const tabs::TabInterface* tab) const {
+  const auto it = tab_workspaces_.find(tab->GetHandle());
+  if (it != tab_workspaces_.end() && FindWorkspace(it->second)) {
+    return it->second;
+  }
+  return tab->IsPinned() ? kEssentialsId : active_;
+}
+
+void WorkspaceController::SetActive(const std::string& id) {
+  if (id == active_ || !FindWorkspace(id)) {
+    return;
+  }
+  active_ = id;
+  for (auto& observer : observers_) {
+    observer.OnActiveWorkspaceChanged();
+  }
+  ScheduleUpdate();
+}
+
+bool WorkspaceController::IsClosingWindow() const {
+  if (!model_ || model_->closing_all()) {
+    return true;
+  }
+  const auto* unload = UnloadController::From(browser_);
+  return unload && (unload->is_attempting_to_close_browser() ||
+                    unload->is_delete_scheduled());
+}
+
+bool WorkspaceController::IsRestoring() const {
+  return SessionRestore::IsRestoring(browser_->GetProfile());
+}
+
+void WorkspaceController::ScheduleUpdate() {
+  if (updating_ || update_pending_ || !model_) {
+    return;
+  }
+  update_pending_ = true;
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&WorkspaceController::Update, weak_factory_.GetWeakPtr()));
+}
+
+void WorkspaceController::Update() {
+  update_pending_ = false;
+  if (IsClosingWindow() || IsRestoring()) {
+    return;
+  }
+  {
+    base::AutoReset<bool> updating(&updating_, true);
+    AssignUnits();
+    ArrangeTabs();
+  }
+  if (auto* tab = model_->GetActiveTab()) {
+    SetActive(GetWorkspaceIdOf(tab));
+  }
+  Persist();
+  NotifyWorkspacesChanged();
+}
+
+void WorkspaceController::AssignUnits() {
+  std::map<tab_groups::TabGroupId, std::string> groups;
+  std::map<split_tabs::SplitTabId, std::string> splits;
+  std::erase_if(tab_workspaces_, [this](const auto& entry) {
+    const auto* tab = entry.first.Get();
+    return !tab || model_->GetIndexOfTab(tab) == TabStripModel::kNoTab;
+  });
+  for (auto* tab : *model_) {
+    std::string id = GetWorkspaceIdOf(tab);
+    if (const auto group = tab->GetGroup()) {
+      id = groups.try_emplace(*group, id).first->second;
+    } else if (const auto split = tab->GetSplit()) {
+      id = splits.try_emplace(*split, id).first->second;
+    }
+    tab_workspaces_[tab->GetHandle()] = id;
+  }
+}
+
+void WorkspaceController::ArrangeTabs() {
+  std::vector<std::pair<std::string, Unit>> units;
+  for (auto* tab : *model_) {
+    const auto group = tab->GetGroup();
+    const auto split = group ? std::nullopt : tab->GetSplit();
+    if (!units.empty()) {
+      const Unit& last = units.back().second;
+      if ((group && last.group == group) || (split && last.split == split)) {
+        continue;
+      }
+    }
+    units.emplace_back(GetWorkspaceIdOf(tab),
+                       Unit{tab->GetHandle(), group, split});
+  }
+  std::vector<std::string> order = {kEssentialsId};
+  for (const auto& workspace : workspaces_) {
+    order.push_back(workspace.id);
+  }
+  for (const bool pinned : {true, false}) {
+    int target = pinned ? 0 : model_->IndexOfFirstNonPinnedTab();
+    for (const auto& workspace_id : order) {
+      for (const auto& [id, unit] : units) {
+        const tabs::TabInterface* tab = unit.first.Get();
+        if (id != workspace_id || tab->IsPinned() != pinned) {
+          continue;
+        }
+        const int index = model_->GetIndexOfTab(tab);
+        int size = 1;
+        if (unit.group) {
+          size = model_->group_model()->GetTabGroup(*unit.group)->tab_count();
+          if (index != target) {
+            model_->MoveGroupTo(*unit.group, target);
+          }
+        } else if (unit.split) {
+          size = static_cast<int>(
+              model_->GetSplitData(*unit.split)->ListTabs().size());
+          if (index != target) {
+            model_->MoveSplitTo(*unit.split, target, pinned, std::nullopt);
+          }
+        } else if (index != target) {
+          model_->MoveWebContentsAt(index, target, false, std::nullopt);
+        }
+        target += size;
+      }
+    }
+  }
+}
+
+void WorkspaceController::Persist() {
+  auto* service =
+      SessionServiceFactory::GetForProfileIfExisting(browser_->GetProfile());
+  if (!service) {
+    return;
+  }
+  const std::string window = Serialize(workspaces_, active_);
+  if (window != persisted_window_) {
+    service->AddWindowExtraData(browser_->GetSessionID(),
+                                BrowserWindowCreateParams::kWorkspacesKey,
+                                window);
+    persisted_window_ = window;
+  }
+  std::erase_if(persisted_tab_workspaces_, [this](const auto& entry) {
+    return !tab_workspaces_.contains(entry.first);
+  });
+  for (const auto& [handle, id] : tab_workspaces_) {
+    auto& persisted = persisted_tab_workspaces_[handle];
+    if (persisted == id) {
+      continue;
+    }
+    service->AddTabExtraData(
+        browser_->GetSessionID(),
+        sessions::SessionTabHelper::IdForTab(handle.Get()->GetContents()),
+        chrome::kWorkspaceIdExtraDataKey, id);
+    persisted = id;
+  }
+}
+
+void WorkspaceController::NotifyWorkspacesChanged() {
+  for (auto& observer : observers_) {
+    observer.OnWorkspacesChanged();
+  }
+}
+
+void WorkspaceController::OnSessionRestored(Profile* profile, int tab_count) {
+  if (profile == browser_->GetProfile()) {
+    ScheduleUpdate();
+  }
+}
+
+void WorkspaceController::OnTabStripModelChanged(
+    TabStripModel* model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() == TabStripModelChange::kInserted) {
+    for (const auto& inserted : change.GetInsert()->contents) {
+      const std::string restored =
+          chrome::TakeRestoredWorkspaceId(inserted.contents);
+      tab_workspaces_[inserted.tab->GetHandle()] =
+          FindWorkspace(restored) ? restored : GetWorkspaceIdOf(inserted.tab);
+    }
+  } else if (change.type() == TabStripModelChange::kRemoved) {
+    for (const auto& removed : change.GetRemove()->contents) {
+      std::erase(activation_order_, removed.tab->GetHandle());
+      tab_workspaces_.erase(removed.tab->GetHandle());
+    }
+  }
+  if (selection.active_tab_changed() && selection.new_tab) {
+    const auto handle = selection.new_tab->GetHandle();
+    std::erase(activation_order_, handle);
+    activation_order_.push_back(handle);
+    if (!IsRestoring()) {
+      SetActive(GetWorkspaceIdOf(selection.new_tab));
+    }
+  }
+  ScheduleUpdate();
+}
+
+void WorkspaceController::OnTabPinnedStateChanged(tabs::TabInterface* tab,
+                                                  int index) {
+  tab_workspaces_[tab->GetHandle()] = GetWorkspaceIdOf(tab);
+  ScheduleUpdate();
+}
+
+void WorkspaceController::TabGroupedStateChanged(
+    TabStripModel* model,
+    std::optional<tab_groups::TabGroupId> old_group,
+    std::optional<tab_groups::TabGroupId> new_group,
+    tabs::TabInterface* tab,
+    int index) {
+  ScheduleUpdate();
+}
+
+void WorkspaceController::OnSplitTabChanged(const SplitTabChange& change) {
+  ScheduleUpdate();
+}
+
+void WorkspaceController::OnTabStripModelDestroyed(TabStripModel* model) {
+  model_ = nullptr;
+  weak_factory_.InvalidateWeakPtrs();
+}
+
+}  // namespace workspaces
