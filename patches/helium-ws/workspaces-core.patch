+TEST_F(WorkspaceControllerTest, HorizontalSwitchCollapsesOnlyInactiveGroups) {
+  const auto first = AddUngroupedTab()->GetGroup().value();
+  const auto second = controller()->CreateWorkspace();
+  EXPECT_TRUE(tabs::VerticalTabStripStateController::From(browser())
+                  ->ShouldDisplayVerticalTabs());
+  tabs::VerticalTabStripStateController::From(browser())
+      ->SetVerticalTabsEnabled(false);
+  controller()->ActivateWorkspace(first);
+  Flush();
+  EXPECT_FALSE(model()
+                   ->group_model()
+                   ->GetTabGroup(first)
+                   ->visual_data()
+                   ->is_collapsed());
+  EXPECT_TRUE(model()
+                  ->group_model()
+                  ->GetTabGroup(second)
+                  ->visual_data()
+                  ->is_collapsed());
+}
