@@ -0,0 +1,214 @@
+// Copyright 2026 The Helium Authors
+// You can use, redistribute, and/or modify this source code under
+// the terms of the GPL-3.0 license that can be found in the LICENSE file.
+
+#include "chrome/browser/ui/workspaces/workspace_controller.h"
+
+#include "base/run_loop.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/tabs/tab_group_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model.h"
+#include "chrome/browser/ui/tabs/tab_strip_model_delegate.h"
+#include "chrome/browser/ui/tabs/vertical_tab_strip_state_controller.h"
+#include "chrome/common/webui_url_constants.h"
+#include "chrome/grit/generated_resources.h"
+#include "chrome/test/base/browser_with_test_window_test.h"
+#include "components/tabs/public/tab_group.h"
+#include "content/public/browser/web_contents.h"
+#include "ui/base/l10n/l10n_util.h"
+#include "url/gurl.h"
+
+namespace workspaces {
+
+class WorkspaceControllerTest : public BrowserWithTestWindowTest {
+ protected:
+  WorkspaceController* controller() {
+    return WorkspaceController::From(browser());
+  }
+  TabStripModel* model() { return browser()->GetTabStripModel(); }
+  void Flush() { base::RunLoop().RunUntilIdle(); }
+  tabs::TabInterface* AddUngroupedTab() {
+    AddTab(browser(), GURL("https://example.test/"));
+    auto* tab = model()->GetActiveTab();
+    Flush();
+    return tab;
+  }
+};
+
+TEST_F(WorkspaceControllerTest, UngroupedInsertCreatesDefaultWorkspace) {
+  ASSERT_NE(nullptr, controller());
+  auto* tab = AddUngroupedTab();
+  ASSERT_TRUE(tab->GetGroup());
+  EXPECT_EQ(tab->GetGroup(), controller()->GetActiveWorkspace());
+  EXPECT_EQ(1u, controller()->GetWorkspaces().size());
+  EXPECT_EQ(l10n_util::GetStringUTF16(IDS_WORKSPACE_DEFAULT_NAME),
+            model()
+                ->group_model()
+                ->GetTabGroup(*tab->GetGroup())
+                ->visual_data()
+                ->title());
+  auto* second = AddUngroupedTab();
+  EXPECT_EQ(tab->GetGroup(), second->GetGroup());
+}
+
+TEST_F(WorkspaceControllerTest, EssentialRetainsWorkspaceAndUnpinsIntoIt) {
+  auto* essential = AddUngroupedTab();
+  AddUngroupedTab();
+  model()->SetTabPinned(model()->GetIndexOfTab(essential), true);
+  const auto second = controller()->CreateWorkspace();
+  model()->ActivateTab(essential);
+  Flush();
+  EXPECT_EQ(second, controller()->GetActiveWorkspace());
+  EXPECT_TRUE(controller()->IsTabVisible(essential));
+  model()->SetTabPinned(model()->GetIndexOfTab(essential), false);
+  Flush();
+  EXPECT_EQ(second, essential->GetGroup());
+}
+
+TEST_F(WorkspaceControllerTest, ActivatesMostRecentlyUsedTabInWorkspace) {
+  auto* first = AddUngroupedTab();
+  const auto group = first->GetGroup().value();
+  auto* second = AddUngroupedTab();
+  model()->ActivateTab(first);
+  controller()->CreateWorkspace();
+  controller()->ActivateWorkspace(group);
+  EXPECT_EQ(first, model()->GetActiveTab());
+  model()->ActivateTab(second);
+  controller()->ActivateNextWorkspace();
+  controller()->ActivatePreviousWorkspace();
+  EXPECT_EQ(second, model()->GetActiveTab());
+}
+
+TEST_F(WorkspaceControllerTest,
+       BackgroundGroupDoesNotChangeEssentialWorkspace) {
+  auto* essential = AddUngroupedTab();
+  const auto first = essential->GetGroup().value();
+  auto* background = AddUngroupedTab();
+  AddUngroupedTab();
+  model()->SetTabPinned(model()->GetIndexOfTab(essential), true);
+  model()->ActivateTab(essential);
+  model()->AddToNewGroup({model()->GetIndexOfTab(background)});
+  Flush();
+  EXPECT_EQ(first, controller()->GetActiveWorkspace());
+}
+
+TEST_F(WorkspaceControllerTest,
+       VisibleTabsContainEssentialsThenActiveWorkspace) {
+  auto* essential = AddUngroupedTab();
+  auto* first = AddUngroupedTab();
+  model()->SetTabPinned(model()->GetIndexOfTab(essential), true);
+  const auto second_group = controller()->CreateWorkspace();
+  auto* second = model()->GetActiveTab();
+  Flush();
+  EXPECT_FALSE(controller()->IsTabVisible(first));
+  EXPECT_EQ((std::vector<tabs::TabInterface*>{essential, second}),
+            controller()->GetVisibleTabs());
+  EXPECT_EQ(second_group, controller()->GetActiveWorkspace());
+  controller()->ActivateWorkspaceAt(-1);
+  controller()->ActivateWorkspaceAt(100);
+  EXPECT_EQ(second, model()->GetActiveTab());
+}
+
+TEST_F(WorkspaceControllerTest, NativeRestoredGroupsAndPinnedTabsArePreserved) {
+  AddTab(browser(), GURL("https://restored.test/"));
+  auto* grouped = model()->GetActiveTab();
+  const auto restored = tab_groups::TabGroupId::GenerateNew();
+  model()->AddToGroupForRestore({model()->GetIndexOfTab(grouped)}, restored);
+  model()->ChangeTabGroupVisuals(
+      restored, tab_groups::TabGroupVisualData(
+                    u"Restored", tab_groups::TabGroupColorId::kBlue));
+  AddTab(browser(), GURL("https://essential.test/"));
+  auto* pinned = model()->GetActiveTab();
+  model()->SetTabPinned(model()->GetIndexOfTab(pinned), true);
+  AddTab(browser(), GURL("https://ungrouped.test/"));
+  auto* ungrouped = model()->GetActiveTab();
+  Flush();
+  EXPECT_TRUE(pinned->IsPinned());
+  EXPECT_FALSE(pinned->GetGroup());
+  EXPECT_EQ(restored, grouped->GetGroup());
+  EXPECT_EQ(restored, ungrouped->GetGroup());
+  EXPECT_EQ(
+      u"Restored",
+      model()->group_model()->GetTabGroup(restored)->visual_data()->title());
+}
