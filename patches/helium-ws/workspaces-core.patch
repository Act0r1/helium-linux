+TEST_F(WorkspaceControllerTest, LastTabCloseKeepsGroupAndInsertsNewTabPage) {
+  auto* tab = AddUngroupedTab();
+  const auto group = tab->GetGroup().value();
+  model()->CloseWebContentsAt(model()->GetIndexOfTab(tab),
+                              TabCloseTypes::CLOSE_NONE);
+  EXPECT_EQ(1, model()->count());
+  ASSERT_TRUE(model()->group_model()->ContainsTabGroup(group));
+  EXPECT_EQ(group, model()->GetTabAtIndex(0)->GetGroup());
+  EXPECT_EQ(GURL(chrome::kChromeUINewTabURL),
+            model()->GetWebContentsAt(0)->GetVisibleURL());
+}
+
+TEST_F(WorkspaceControllerTest, TabStripClosePreservesLastWorkspaceTab) {
+  auto* tab = AddUngroupedTab();
+  const auto group = tab->GetGroup().value();
+  model()->delegate()->CloseTab(tab, CloseTabSource::kFromMouse);
+  EXPECT_EQ(1, model()->count());
+  EXPECT_EQ(group, model()->GetTabAtIndex(0)->GetGroup());
+  EXPECT_EQ(GURL(chrome::kChromeUINewTabURL),
+            model()->GetWebContentsAt(0)->GetVisibleURL());
+}
