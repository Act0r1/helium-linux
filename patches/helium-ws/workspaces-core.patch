   registry->RegisterBooleanPref(prefs::kHeliumVerticalRightAligned, false);
   registry->RegisterBooleanPref(prefs::kHeliumZenMode, false);
   registry->RegisterBooleanPref(prefs::kHeliumZenModeSidebarPinned, false);
