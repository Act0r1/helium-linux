+TEST_F(WorkspaceControllerTest, MovingLastTabPreservesSourceWorkspace) {
+  auto* tab = AddUngroupedTab();
+  const auto source = tab->GetGroup().value();
+  const auto destination = controller()->CreateWorkspace();
+  model()->AddToExistingGroup({model()->GetIndexOfTab(tab)}, destination);
+  EXPECT_TRUE(model()->group_model()->ContainsTabGroup(source));
+  EXPECT_EQ(destination, tab->GetGroup());
+  EXPECT_EQ(3, model()->count());
+}
