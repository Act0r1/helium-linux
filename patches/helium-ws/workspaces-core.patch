+#ifndef CHROME_BROWSER_UI_WORKSPACES_WORKSPACE_CONTROLLER_H_
+#define CHROME_BROWSER_UI_WORKSPACES_WORKSPACE_CONTROLLER_H_
+
+#include <array>
+#include <map>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/observer_list.h"
+#include "base/observer_list_types.h"
