+void BrowserCommandController::UpdateWorkspaceCommands() {
+  if (IsInLockedFullscreenMode(/*allow_ontask=*/false)) {
+    return;
+  }
+  const bool enabled =
+      workspaces::WorkspaceController::From(browser_) != nullptr;
+  constexpr int kCommands[] = {
+      IDC_ACTIVATE_NEXT_WORKSPACE, IDC_ACTIVATE_PREVIOUS_WORKSPACE,
+      IDC_ACTIVATE_WORKSPACE_0,    IDC_ACTIVATE_WORKSPACE_1,
+      IDC_ACTIVATE_WORKSPACE_2,    IDC_ACTIVATE_WORKSPACE_3,
+      IDC_ACTIVATE_WORKSPACE_4,    IDC_ACTIVATE_WORKSPACE_5,
+      IDC_ACTIVATE_WORKSPACE_6,    IDC_ACTIVATE_WORKSPACE_7,
+      IDC_ACTIVATE_WORKSPACE_8,    IDC_NEW_WORKSPACE,
+  };
+  for (int command_id : kCommands) {
+    command_updater_->UpdateCommandEnabled(command_id, enabled);
+  }
+}
