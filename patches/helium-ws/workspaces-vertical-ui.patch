+
+  tab_groups::TabGroupColorId GetColorAt(size_t index) const {
+    return colors_[index];
+  }
+
+  size_t GetItemCount() const override { return colors_.size(); }
+
+  std::u16string GetItemAt(size_t index) const override {
+    return tab_groups::GetTabGroupColorLabelMap().at(colors_[index]);
+  }
+
+  std::optional<size_t> GetDefaultIndex() const override {
+    const auto it = std::ranges::find(colors_, selected_);
+    return it == colors_.end() ? 0 : it - colors_.begin();
+  }
+
+ private:
+  const std::vector<tab_groups::TabGroupColorId> colors_;
+  const tab_groups::TabGroupColorId selected_;
