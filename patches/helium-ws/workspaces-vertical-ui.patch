+std::u16string LeadingEmoji(std::u16string_view title) {
+  if (title.empty()) {
+    return std::u16string();
+  }
+  base::i18n::BreakIterator graphemes(
+      title, base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (!graphemes.Init() || !graphemes.Advance()) {
+    return std::u16string();
+  }
+  const std::u16string_view cluster = graphemes.GetString();
+  for (base::i18n::UTF16CharIterator iter(cluster); !iter.end();
+       iter.Advance()) {
+    const UChar32 codepoint = iter.get();
+    if (u_hasBinaryProperty(codepoint, UCHAR_EMOJI_PRESENTATION) ||
+        u_hasBinaryProperty(codepoint, UCHAR_EXTENDED_PICTOGRAPHIC) ||
+        u_hasBinaryProperty(codepoint, UCHAR_REGIONAL_INDICATOR)) {
+      return std::u16string(cluster);
+    }
+  }
+  return std::u16string();
+}
