+std::u16string FirstGrapheme(std::u16string_view text) {
+  base::i18n::BreakIterator graphemes(
+      text, base::i18n::BreakIterator::BREAK_CHARACTER);
+  if (text.empty() || !graphemes.Init() || !graphemes.Advance()) {
+    return std::u16string();
+  }
+  return std::u16string(graphemes.GetString());
+}
+
+std::u16string IconText(const workspaces::Workspace& workspace) {
+  const std::u16string icon =
+      FirstGrapheme(base::TrimWhitespace(workspace.icon, base::TRIM_ALL));
+  if (!icon.empty()) {
+    return icon;
+  }
+  return base::i18n::ToUpper(
+      FirstGrapheme(base::TrimWhitespace(workspace.name, base::TRIM_ALL)));
+}
+
+SkColor WorkspaceColor(const ui::ColorProvider* provider,
+                       tab_groups::TabGroupColorId color_id) {
+  return provider->GetColor(GetTabGroupContextMenuColorId(color_id));
+}
