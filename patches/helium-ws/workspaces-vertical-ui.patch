+using IconPickedCallback = base::OnceCallback<void(const std::u16string&)>;
+
+// Grid of workspace icons. Picking one runs the callback and closes the bubble.
+class WorkspaceIconGrid : public views::View {
+  METADATA_HEADER(WorkspaceIconGrid, views::View)
+
+ public:
+  WorkspaceIconGrid(
+      IconPickedCallback callback,
+      std::unique_ptr<views::BubbleDialogDelegate::CloseOnDeactivatePin>
+          parent_pin)
+      : callback_(std::move(callback)), parent_pin_(std::move(parent_pin)) {
+    SetLayoutManager(std::make_unique<views::FlexLayout>())
+        ->SetOrientation(views::LayoutOrientation::kVertical);
+    views::View* row = nullptr;
+    for (size_t i = 0; i < workspaces::kWorkspaceIcons.size(); ++i) {
+      if (i % kPickerColumns == 0) {
+        row = AddChildView(std::make_unique<views::View>());
+        row->SetLayoutManager(std::make_unique<views::FlexLayout>());
+      }
+      const std::u16string icon(workspaces::kWorkspaceIcons[i]);
+      row->AddChildView(std::make_unique<WorkspaceChipButton>(
+          base::BindRepeating(&WorkspaceIconGrid::Pick, base::Unretained(this),
+                              icon),
+          icon));
+    }
+  }
+  WorkspaceIconGrid(const WorkspaceIconGrid&) = delete;
+  WorkspaceIconGrid& operator=(const WorkspaceIconGrid&) = delete;
+  ~WorkspaceIconGrid() override = default;
+
+ private:
+  void Pick(const std::u16string& icon) {
+    if (callback_) {
+      std::move(callback_).Run(icon);
+    }
+    GetWidget()->Close();
+  }
+
+  IconPickedCallback callback_;
+  std::unique_ptr<views::BubbleDialogDelegate::CloseOnDeactivatePin>
+      parent_pin_;
+};
