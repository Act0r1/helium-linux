+void TabStripView::UpdateWorkspaceVisibility() {
+  if (!collection_node_ || !workspace_observation_.IsObserving()) {
+    return;
+  }
+  auto* unpinned =
+      collection_node_->GetChildNodeOfType(TabCollectionNode::Type::UNPINNED);
+  if (!unpinned) {
+    return;
+  }
+  auto* controller = workspace_observation_.GetSource();
+  auto* model = collection_node_->GetController()
+                    ->GetBrowserView()
+                    ->browser()
+                    ->GetTabStripModel();
+  TabCollectionNode* active_node = nullptr;
+  if (auto active = controller->GetActiveWorkspace();
+      active && model->group_model()->ContainsTabGroup(*active)) {
+    active_node = unpinned->GetNodeForHandle(
+        model->group_model()->GetTabGroup(*active)->GetCollectionHandle());
+  }
+  for (const auto& child : unpinned->children()) {
+    child->view()->SetVisible(child.get() == active_node);
+  }
+  unpinned->view()->InvalidateLayout();
+  InvalidateLayout();
+}
