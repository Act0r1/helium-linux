+bool IsCollapsed(BrowserWindowInterface* browser) {
+  auto* state = tabs::VerticalTabStripStateController::From(browser);
+  return state && state->GetCollapseState() !=
+                      tabs::VerticalTabStripCollapseState::kExpanded;
+}
