+// Icon and name of the active workspace, shown above its tabs. Clicking the
+// icon opens the icon picker, clicking elsewhere opens the workspace menu.
+class WorkspaceHeaderView : public views::Button,
+                            public workspaces::WorkspaceController::Observer,
+                            public views::ContextMenuController {
+  METADATA_HEADER(WorkspaceHeaderView, views::Button)
+
+ public:
+  explicit WorkspaceHeaderView(BrowserWindowInterface* browser)
+      : Button(base::BindRepeating(&WorkspaceHeaderView::OnPressed,
+                                   base::Unretained(this))),
+        browser_(browser),
+        controller_(workspaces::WorkspaceController::From(browser)),
+        menu_(controller_) {
+    CHECK(controller_);
+    SetLayoutManager(std::make_unique<views::FlexLayout>())
+        ->SetOrientation(views::LayoutOrientation::kHorizontal)
+        .SetCrossAxisAlignment(views::LayoutAlignment::kCenter)
+        .SetInteriorMargin(gfx::Insets::VH(0, 8));
+    views::InstallRoundRectHighlightPathGenerator(this, gfx::Insets(),
+                                                  kCornerRadius);
+    set_context_menu_controller(this);
+
+    icon_ = AddChildView(std::make_unique<WorkspaceChipButton>(
+        base::BindRepeating(&WorkspaceHeaderView::OnIconPressed,
+                            base::Unretained(this)),
+        std::u16string()));
+    icon_->set_context_menu_controller(this);
+    icon_->SetTooltipText(l10n_util::GetStringUTF16(IDS_WORKSPACE_ICON_LABEL));
+    icon_->SetProperty(views::kMarginsKey, gfx::Insets::TLBR(0, -6, 0, 2));
+
+    name_ = AddChildView(std::make_unique<views::Label>());
+    name_->SetCanProcessEventsWithinSubtree(false);
+    name_->SetSubpixelRenderingEnabled(false);
+    name_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+    name_->SetElideBehavior(gfx::ELIDE_TAIL);
+    name_->SetFontList(
+        name_->font_list().DeriveWithWeight(gfx::Font::Weight::SEMIBOLD));
+    name_->SetProperty(views::kFlexBehaviorKey,
+                       views::FlexSpecification(
+                           views::MinimumFlexSizeRule::kScaleToZero,
+                           views::MaximumFlexSizeRule::kUnbounded));
+
+    if (auto* state = tabs::VerticalTabStripStateController::From(browser)) {
+      collapse_changed_subscription_ = state->RegisterOnCollapseChanged(
+          base::BindRepeating(&WorkspaceHeaderView::OnCollapseChanged,
+                              base::Unretained(this)));
+    }
+    controller_observation_.Observe(controller_);
+    Update();
+  }
+
+  WorkspaceHeaderView(const WorkspaceHeaderView&) = delete;
+  WorkspaceHeaderView& operator=(const WorkspaceHeaderView&) = delete;
+  ~WorkspaceHeaderView() override = default;
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(0, kHeaderHeight);
+  }
+
+  void OnWorkspacesChanged() override { Update(); }
+
+  void OnActiveWorkspaceChanged() override { Update(); }
+
+  void OnThemeChanged() override {
+    views::Button::OnThemeChanged();
+    Update();
+  }
+
+ private:
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    ShowMenu(gfx::Rect(point, gfx::Size()),
+             views::MenuAnchorPosition::kTopLeft, source_type);
+  }
+
+  void OnPressed(const ui::Event& event) {
+    ShowMenu(GetBoundsInScreen(), views::MenuAnchorPosition::kTopLeft,
+             ui::mojom::MenuSourceType::kMouse);
+  }
+
+  void OnIconPressed() {
+    if (const workspaces::Workspace* active =
+            controller_->GetActiveWorkspace()) {
+      ShowIconPicker(icon_, base::BindOnce(&WorkspaceHeaderView::SetIcon,
+                                           weak_factory_.GetWeakPtr(),
+                                           active->id));
+    }
+  }
+
+  void SetIcon(const std::string& id, const std::u16string& icon) {
+    const auto& workspaces = controller_->GetWorkspaces();
+    const auto it =
+        std::ranges::find(workspaces, id, &workspaces::Workspace::id);
+    if (it == workspaces.end()) {
+      return;
+    }
+    workspaces::Workspace workspace = *it;
+    workspace.icon = icon;
+    controller_->UpdateWorkspace(workspace);
+  }
+
+  void ShowMenu(const gfx::Rect& bounds,
+                views::MenuAnchorPosition position,
+                ui::mojom::MenuSourceType source_type) {
+    if (const workspaces::Workspace* active =
+            controller_->GetActiveWorkspace()) {
+      menu_.Show(this, active->id, bounds, position, source_type);
+    }
+  }
+
+  void OnCollapseChanged(tabs::VerticalTabStripCollapseState state) {
+    Update();
+  }
+
+  void Update() {
+    const bool visible = controller_->IsFilteringTabs();
+    if (GetVisible() != visible) {
+      SetVisible(visible);
+    }
+    const workspaces::Workspace* active = controller_->GetActiveWorkspace();
+    if (!active) {
+      return;
+    }
+    const bool collapsed = IsCollapsed(browser_);
+    icon_->SetText(IconText(*active));
+    name_->SetText(active->name);
+    name_->SetVisible(!collapsed);
+    GetViewAccessibility().SetName(l10n_util::GetStringFUTF16(
+        IDS_WORKSPACE_ITEM_ACCNAME, active->name));
+    SetTooltipText(active->name);
+    if (const ui::ColorProvider* provider = GetColorProvider()) {
+      const SkColor color = WorkspaceColor(provider, active->color);
+      SetBackground(views::CreateRoundedRectBackground(
+          SkColorSetA(color, kHeaderAlpha), kCornerRadius));
+      icon_->SetEnabledTextColors(color);
+      name_->SetEnabledColor(provider->GetColor(ui::kColorLabelForeground));
+    }
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<workspaces::WorkspaceController> controller_;
+  WorkspaceMenu menu_;
+  raw_ptr<views::LabelButton> icon_ = nullptr;
+  raw_ptr<views::Label> name_ = nullptr;
+  base::CallbackListSubscription collapse_changed_subscription_;
+  base::ScopedObservation<workspaces::WorkspaceController,
+                          workspaces::WorkspaceController::Observer>
+      controller_observation_{this};
+  base::WeakPtrFactory<WorkspaceHeaderView> weak_factory_{this};
+};
