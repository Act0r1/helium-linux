+class WorkspaceSwitcherView : public views::FlexLayoutView,
+                              public workspaces::WorkspaceController::Observer,
+                              public TabStripModelObserver,
+                              public views::ContextMenuController {
+  METADATA_HEADER(WorkspaceSwitcherView, views::FlexLayoutView)
+
+ public:
+  explicit WorkspaceSwitcherView(BrowserWindowInterface* browser)
+      : browser_(browser),
+        state_controller_(
+            browser ? tabs::VerticalTabStripStateController::From(browser)
+                    : nullptr),
+        editor_bubble_tracker_(state_controller_) {
+    SetOrientation(views::LayoutOrientation::kHorizontal);
+    SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    SetMainAxisAlignment(views::LayoutAlignment::kStart);
+    SetInteriorMargin(gfx::Insets::VH(2, 0));
+    SetProperty(views::kFlexBehaviorKey,
+                views::FlexSpecification(
+                    views::MinimumFlexSizeRule::kPreferred,
+                    views::MaximumFlexSizeRule::kPreferred));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kToolbar);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_WORKSPACE_SWITCHER_ACCNAME));
+
+    auto scroll_view = std::make_unique<views::ScrollView>();
+    scroll_view->SetBackgroundColor(std::nullopt);
+    scroll_view->SetUseContentsPreferredSize(true);
+    scroll_view->SetHorizontalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kHiddenButEnabled);
+    scroll_view->SetVerticalScrollBarMode(
+        views::ScrollView::ScrollBarMode::kDisabled);
+    scroll_view->SetTreatAllScrollEventsAsHorizontal(true);
+    scroll_view->SetOverflowGradientMask(
+        views::ScrollView::GradientDirection::kHorizontal);
+    scroll_view->SetProperty(views::kFlexBehaviorKey,
+                             views::FlexSpecification(
+                                 views::MinimumFlexSizeRule::kScaleToZero,
+                                 views::MaximumFlexSizeRule::kPreferred));
+    chips_ = scroll_view->SetContents(std::make_unique<WorkspaceChipStrip>());
+    AddChildView(std::move(scroll_view));
+
+    const std::u16string new_workspace_label =
+        l10n_util::GetStringUTF16(IDS_WORKSPACE_NEW_TOOLTIP);
+    auto add_button = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&WorkspaceSwitcherView::CreateNewWorkspace,
+                            weak_factory_.GetWeakPtr()),
+        u"+");
+    ConfigureChip(add_button.get());
+    add_button->SetTooltipText(new_workspace_label);
+    add_button->SetAccessibleName(new_workspace_label);
+    add_button->SetProperty(views::kMarginsKey, gfx::Insets::VH(0, 2));
+    add_button_ = AddChildView(std::move(add_button));
+
+    bubble_closed_subscription_ =
+        editor_bubble_tracker_.RegisterOnBubbleClosed(base::BindRepeating(
+            &WorkspaceSwitcherView::ScheduleRebuild, base::Unretained(this)));
+    if (state_controller_) {
+      collapsed_ = state_controller_->GetCollapseState() !=
+                   tabs::VerticalTabStripCollapseState::kExpanded;
+      collapse_changed_subscription_ =
+          state_controller_->RegisterOnCollapseChanged(base::BindRepeating(
+              &WorkspaceSwitcherView::OnCollapseChanged,
+              base::Unretained(this)));
+    }
+
+    if (browser_) {
+      controller_ = workspaces::WorkspaceController::From(browser_);
+    }
+    if (controller_) {
+      controller_observation_.Observe(controller_);
+      browser_->GetTabStripModel()->AddObserver(this);
+    }
+    RebuildNow();
+  }
+
+  WorkspaceSwitcherView(const WorkspaceSwitcherView&) = delete;
+  WorkspaceSwitcherView& operator=(const WorkspaceSwitcherView&) = delete;
+  ~WorkspaceSwitcherView() override = default;
+
+  void OnWorkspacesChanged() override { ScheduleRebuild(); }
+
+  void OnActiveWorkspaceChanged() override { ScheduleRebuild(); }
+
+  void OnTabGroupChanged(const TabGroupChange& change) override {
+    switch (change.type) {
+      case TabGroupChange::kCreated:
+      case TabGroupChange::kVisualsChanged:
+      case TabGroupChange::kMoved:
+      case TabGroupChange::kClosed:
+        ScheduleRebuild();
+        break;
+      case TabGroupChange::kEditorOpened:
+        break;
+    }
+  }
+
+  void OnThemeChanged() override {
+    views::FlexLayoutView::OnThemeChanged();
+    ScheduleRebuild();
+  }
+
+ private:
+  void ShowContextMenuForViewImpl(
+      views::View* source,
+      const gfx::Point& point,
+      ui::mojom::MenuSourceType source_type) override {
+    auto* chip = views::AsViewClass<WorkspaceChipButton>(source);
+    if (!chip || !browser_ || editor_bubble_tracker_.is_open()) {
+      return;
+    }
+    TabStripModel* model = browser_->GetTabStripModel();
+    if (!model->group_model() ||
+        !model->group_model()->ContainsTabGroup(chip->group_id())) {
+      return;
+    }
+
+    constexpr bool kStopContextMenuPropagation =
+#if BUILDFLAG(IS_MAC)
+        false;
+#else
+        true;
+#endif
+    editor_bubble_tracker_.Opened(TabGroupEditorBubbleView::Show(
+        browser_, chip->group_id(), chip, std::nullopt,
+        kStopContextMenuPropagation));
+  }
+
+  void OnCollapseChanged(tabs::VerticalTabStripCollapseState state) {
+    collapsed_ = state != tabs::VerticalTabStripCollapseState::kExpanded;
+    ScheduleRebuild();
+  }
+
+  void ScheduleRebuild() {
+    if (rebuild_scheduled_) {
+      return;
+    }
+    rebuild_scheduled_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WorkspaceSwitcherView::RebuildNow,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void RebuildNow() {
+    rebuild_scheduled_ = false;
+    if (editor_bubble_tracker_.is_open()) {
+      return;
+    }
+
+    chips_->RemoveAllChildViews();
+    if (!controller_ || !browser_) {
+      SetVisible(false);
+      SetPreferredSize(gfx::Size());
+      return;
+    }
+
+    SetVisible(true);
+    SetPreferredSize(std::nullopt);
+    SetMainAxisAlignment(collapsed_ ? views::LayoutAlignment::kCenter
+                                    : views::LayoutAlignment::kStart);
+    add_button_->SetVisible(!collapsed_);
+
+    TabStripModel* model = browser_->GetTabStripModel();
+    TabGroupModel* groups = model->group_model();
+    const std::optional<tab_groups::TabGroupId> active =
+        controller_->GetActiveWorkspace();
+    for (const tab_groups::TabGroupId& group_id : controller_->GetWorkspaces()) {
+      if (!groups || !groups->ContainsTabGroup(group_id) ||
+          (collapsed_ && active != group_id)) {
+        continue;
+      }
+      const tab_groups::TabGroupVisualData* visuals =
+          groups->GetTabGroup(group_id)->visual_data();
+      const std::u16string& title = visuals->title();
+      auto chip = std::make_unique<WorkspaceChipButton>(
+          base::BindRepeating(&WorkspaceSwitcherView::ActivateWorkspaceById,
+                              weak_factory_.GetWeakPtr(), group_id),
+          LeadingEmoji(title), group_id);
+      ConfigureChip(chip.get());
+      chip->SetTooltipText(title);
+      chip->SetAccessibleName(
+          l10n_util::GetStringFUTF16(IDS_WORKSPACE_ITEM_ACCNAME, title));
+      chip->set_context_menu_controller(this);
+      ApplyChipBackground(chip.get(), visuals->color(), active == group_id);
+      chips_->AddChildView(std::move(chip));
+      if (active == group_id) {
+        chips_->ScrollChildToVisibleOnLayout(chips_->children().size() - 1);
+      }
+    }
+    InvalidateLayout();
+  }
+
+  void ConfigureChip(views::LabelButton* button) {
+    button->SetPreferredSize(gfx::Size(kChipSize, kChipSize));
+    button->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    button->SetBorder(views::CreateEmptyBorder(0));
+    views::InstallCircleHighlightPathGenerator(button);
+  }
+
+  void ApplyChipBackground(views::LabelButton* chip,
+                           tab_groups::TabGroupColorId color_id,
+                           bool active) {
+    const ui::ColorProvider* provider = GetColorProvider();
+    if (!provider) {
+      return;
+    }
+    SkColor color =
+        provider->GetColor(GetTabGroupContextMenuColorId(color_id));
+    color = SkColorSetA(color, active ? SK_AlphaOPAQUE : kInactiveChipAlpha);
+    chip->SetBackground(views::CreateRoundedRectBackground(
+        color, static_cast<float>(kChipSize) / 2.0f));
+  }
+
+  void ActivateWorkspaceById(tab_groups::TabGroupId group_id) {
+    if (controller_) {
+      controller_->ActivateWorkspace(group_id);
+    }
+  }
+
+  void CreateNewWorkspace() {
+    if (controller_) {
+      controller_->CreateWorkspace();
+    }
+  }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<tabs::VerticalTabStripStateController> state_controller_;
