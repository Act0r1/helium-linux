+// Shows the workspace context menu (edit, new, close) and the edit bubble.
+class WorkspaceMenu : public ui::SimpleMenuModel::Delegate {
+ public:
+  explicit WorkspaceMenu(workspaces::WorkspaceController* controller)
+      : controller_(controller) {}
+  WorkspaceMenu(const WorkspaceMenu&) = delete;
+  WorkspaceMenu& operator=(const WorkspaceMenu&) = delete;
+  ~WorkspaceMenu() override = default;
+
+  bool IsRunning() const { return runner_ && runner_->IsRunning(); }
+
+  void Show(views::View* anchor,
+            const std::string& workspace_id,
+            const gfx::Rect& bounds,
+            views::MenuAnchorPosition position,
+            ui::mojom::MenuSourceType source_type) {
+    workspace_id_ = workspace_id;
+    anchor_.SetView(anchor);
+    model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    model_->AddItemWithStringId(kEditCommand, IDS_WORKSPACE_EDIT);
+    model_->AddItemWithStringId(kNewCommand, IDS_WORKSPACE_NEW_TOOLTIP);
+    model_->AddSeparator(ui::NORMAL_SEPARATOR);
+    model_->AddItemWithStringId(kCloseCommand, IDS_WORKSPACE_CLOSE);
+    runner_ = std::make_unique<views::MenuRunner>(
+        model_.get(),
+        views::MenuRunner::HAS_MNEMONICS | views::MenuRunner::CONTEXT_MENU);
+    runner_->RunMenuAt(anchor->GetWidget(), nullptr, bounds, position,
+                       source_type);
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  bool IsCommandIdEnabled(int command_id) const override {
+    return command_id != kCloseCommand ||
+           controller_->GetWorkspaces().size() > 1;
+  }
+
+  void ExecuteCommand(int command_id, int event_flags) override {
+    switch (command_id) {
+      case kEditCommand:
+        ShowEditor();
+        break;
+      case kNewCommand:
+        controller_->CreateWorkspace();
+        break;
+      case kCloseCommand:
+        controller_->CloseWorkspace(workspace_id_);
+        break;
+    }
+  }
+
+ private:
+  void ShowEditor() {
+    const auto& workspaces = controller_->GetWorkspaces();
+    const auto it = std::ranges::find(workspaces, workspace_id_,
+                                      &workspaces::Workspace::id);
+    if (it == workspaces.end() || !anchor_.view()) {
+      return;
+    }
+    auto icon_row = std::make_unique<views::FlexLayoutView>();
+    WorkspaceIconButton* icon_button = icon_row->AddChildView(
+        std::make_unique<WorkspaceIconButton>(IconText(*it)));
+    auto color_model = std::make_unique<ColorComboboxModel>(it->color);
+    const ColorComboboxModel* colors = color_model.get();
+    auto model_holder = std::make_unique<raw_ptr<ui::DialogModel>>();
+    raw_ptr<ui::DialogModel>* model_ptr = model_holder.get();
+    std::unique_ptr<ui::DialogModel> model =
+        ui::DialogModel::Builder()
+            .SetTitle(l10n_util::GetStringUTF16(IDS_WORKSPACE_EDIT))
+            .SetDialogDestroyingCallback(base::DoNothingWithBoundArgs(
+                KeepTabStripState(anchor_.view())))
+            .AddCustomField(
+                std::make_unique<views::BubbleDialogModelHost::CustomView>(
+                    std::move(icon_row),
+                    views::BubbleDialogModelHost::FieldType::kControl,
+                    icon_button),
+                kWorkspaceIconFieldId)
+            .AddTextfield(kWorkspaceNameFieldId,
+                          l10n_util::GetStringUTF16(IDS_WORKSPACE_NAME_LABEL),
+                          it->name)
+            .AddCombobox(kWorkspaceColorFieldId,
+                         l10n_util::GetStringUTF16(IDS_WORKSPACE_COLOR_LABEL),
+                         std::move(color_model))
+            .AddOkButton(base::BindOnce(&WorkspaceMenu::ApplyEdit,
+                                        weak_factory_.GetWeakPtr(), *it,
+                                        std::move(model_holder), icon_button,
+                                        colors))
+            .AddCancelButton(base::DoNothing())
+            .SetInitiallyFocusedField(kWorkspaceNameFieldId)
+            .Build();
+    *model_ptr = model.get();
+    auto bubble = std::make_unique<views::BubbleDialogModelHost>(
+        std::move(model), anchor_.view(), views::BubbleBorder::TOP_LEFT);
+    views::BubbleDialogDelegate::CreateBubbleDeprecated(
+        std::move(bubble), views::Widget::InitParams::NATIVE_WIDGET_OWNS_WIDGET)
+        ->Show();
+  }
+
+  void ApplyEdit(workspaces::Workspace workspace,
+                 std::unique_ptr<raw_ptr<ui::DialogModel>> model,
+                 const WorkspaceIconButton* icon,
+                 const ColorComboboxModel* colors) {
+    ui::DialogModel* dialog = model->get();
+    const std::u16string name = std::u16string(base::TrimWhitespace(
+        dialog->GetTextfieldByUniqueId(kWorkspaceNameFieldId)->text(),
+        base::TRIM_ALL));
+    if (!name.empty()) {
+      workspace.name = name;
+    }
+    workspace.icon = icon->GetText();
+    workspace.color = colors->GetColorAt(
+        dialog->GetComboboxByUniqueId(kWorkspaceColorFieldId)
+            ->selected_index());
+    controller_->UpdateWorkspace(workspace);
+  }
+
+  const raw_ptr<workspaces::WorkspaceController> controller_;
+  std::string workspace_id_;
+  views::ViewTracker anchor_;
+  std::unique_ptr<ui::SimpleMenuModel> model_;
+  std::unique_ptr<views::MenuRunner> runner_;
+  base::WeakPtrFactory<WorkspaceMenu> weak_factory_{this};
+};
+
+// The row of workspace icons at the bottom of the vertical tab strip.
+class WorkspaceSwitcherView : public views::FlexLayoutView,
+                              public workspaces::WorkspaceController::Observer {
+  METADATA_HEADER(WorkspaceSwitcherView, views::FlexLayoutView)
+
+ public:
+  explicit WorkspaceSwitcherView(BrowserWindowInterface* browser)
+      : browser_(browser),
+        controller_(workspaces::WorkspaceController::From(browser)) {
+    CHECK(controller_);
+    SetOrientation(views::LayoutOrientation::kHorizontal);
+    SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    SetInteriorMargin(gfx::Insets::VH(6, 0));
+    GetViewAccessibility().SetRole(ax::mojom::Role::kToolbar);
+    GetViewAccessibility().SetName(
+        l10n_util::GetStringUTF16(IDS_WORKSPACE_SWITCHER_ACCNAME));
+
+    auto chips = std::make_unique<views::FlexLayoutView>();
+    chips->SetOrientation(views::LayoutOrientation::kHorizontal);
+    chips->SetCrossAxisAlignment(views::LayoutAlignment::kCenter);
+    chips->SetMainAxisAlignment(views::LayoutAlignment::kCenter);
+    chips->SetDefault(views::kMarginsKey, gfx::Insets::VH(0, 2));
+    chips->SetProperty(views::kFlexBehaviorKey,
+                       views::FlexSpecification(
+                           views::LayoutOrientation::kHorizontal,
+                           views::MinimumFlexSizeRule::kScaleToZero,
+                           views::MaximumFlexSizeRule::kUnbounded));
+    chips_ = AddChildView(std::move(chips));
+
+    const std::u16string new_workspace_label =
+        l10n_util::GetStringUTF16(IDS_WORKSPACE_NEW_TOOLTIP);
+    auto add_button = std::make_unique<WorkspaceChipButton>(
+        base::BindRepeating(&WorkspaceSwitcherView::CreateNewWorkspace,
+                            base::Unretained(this)),
+        u"+");
+    add_button->SetTooltipText(new_workspace_label);
+    add_button->GetViewAccessibility().SetName(new_workspace_label);
+    add_button_ = AddChildView(std::move(add_button));
+
+    if (auto* state = tabs::VerticalTabStripStateController::From(browser)) {
+      collapse_changed_subscription_ =
+          state->RegisterOnCollapseChanged(base::BindRepeating(
+              &WorkspaceSwitcherView::OnCollapseChanged,
+              base::Unretained(this)));
+    }
+
+    controller_observation_.Observe(controller_);
+    Rebuild();
+  }
+
+  WorkspaceSwitcherView(const WorkspaceSwitcherView&) = delete;
+  WorkspaceSwitcherView& operator=(const WorkspaceSwitcherView&) = delete;
+  ~WorkspaceSwitcherView() override = default;
+
+  void OnWorkspacesChanged() override { ScheduleRebuild(); }
+
+  void OnActiveWorkspaceChanged() override { ScheduleRebuild(); }
+
+  void OnThemeChanged() override {
+    views::FlexLayoutView::OnThemeChanged();
+    ScheduleRebuild();
+  }
+
+ private:
+  void OnCollapseChanged(tabs::VerticalTabStripCollapseState state) {
+    ScheduleRebuild();
+  }
+
+  void ScheduleRebuild() {
+    if (rebuild_scheduled_) {
+      return;
+    }
+    rebuild_scheduled_ = true;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&WorkspaceSwitcherView::Rebuild,
+                                  weak_factory_.GetWeakPtr()));
+  }
+
+  void Rebuild() {
+    rebuild_scheduled_ = false;
+    const bool collapsed = IsCollapsed(browser_);
+    chips_->RemoveAllChildViews();
+    add_button_->SetVisible(!collapsed);
+
+    const ui::ColorProvider* provider = GetColorProvider();
+    if (provider) {
+      add_button_->SetEnabledTextColors(SkColorSetA(
+          provider->GetColor(ui::kColorLabelForeground), kInactiveTextAlpha));
+    }
+    const workspaces::Workspace* active = controller_->GetActiveWorkspace();
+    for (const auto& workspace : controller_->GetWorkspaces()) {
+      const bool is_active = active && active->id == workspace.id;
+      if (collapsed && !is_active) {
+        continue;
+      }
+      auto chip = std::make_unique<WorkspaceChipButton>(
+          base::BindRepeating(&WorkspaceSwitcherView::ActivateWorkspace,
+                              base::Unretained(this), workspace.id),
+          IconText(workspace));
+      chip->SetTooltipText(workspace.name);
+      chip->GetViewAccessibility().SetName(l10n_util::GetStringFUTF16(
+          IDS_WORKSPACE_ITEM_ACCNAME, workspace.name));
+      if (provider) {
+        const SkColor color = WorkspaceColor(provider, workspace.color);
+        const SkColor text = provider->GetColor(ui::kColorLabelForeground);
+        if (is_active) {
+          chip->SetBackground(views::CreateRoundedRectBackground(
+              SkColorSetA(color, kActiveChipAlpha), kCornerRadius));
+          chip->SetEnabledTextColors(text);
+        } else {
+          chip->SetEnabledTextColors(SkColorSetA(text, kInactiveTextAlpha));
+        }
+      }
+      chips_->AddChildView(std::move(chip));
+    }
+    InvalidateLayout();
+  }
+
+  void ActivateWorkspace(const std::string& id) {
+    controller_->ActivateWorkspace(id);
+  }
+
+  void CreateNewWorkspace() { controller_->CreateWorkspace(); }
+
+  const raw_ptr<BrowserWindowInterface> browser_;
+  const raw_ptr<workspaces::WorkspaceController> controller_;
+  raw_ptr<views::FlexLayoutView> chips_ = nullptr;
+  raw_ptr<views::LabelButton> add_button_ = nullptr;
+  base::CallbackListSubscription collapse_changed_subscription_;
+  base::ScopedObservation<workspaces::WorkspaceController,
+                          workspaces::WorkspaceController::Observer>
+      controller_observation_{this};
+  bool rebuild_scheduled_ = false;
+  base::WeakPtrFactory<WorkspaceSwitcherView> weak_factory_{this};
+};
+
+BEGIN_METADATA(WorkspaceSwitcherView)
+END_METADATA
