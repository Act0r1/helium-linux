+std::vector<tab_groups::TabGroupColorId> Colors() {
+  std::vector<tab_groups::TabGroupColorId> colors;
+  for (const auto& [color, label] : tab_groups::GetTabGroupColorLabelMap()) {
+    colors.push_back(color);
+  }
+  return colors;
+}
